{
  "name": "airkrit-backend",
  "version": "1.0.0",
  "description": "Backend API for Airkrit platform",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:cluster": "npm run build && pm2 start ecosystem.config.cjs",
    "start:worker": "node dist/worker.js",
    "start:worker:cert": "node dist/certificate-worker.js",
    "start:worker:collab": "node dist/collaboration-worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "scripts:list": "ts-node src/scripts/list-courses-and-categories.ts",
    "scripts:list:out": "ts-node src/scripts/list-courses-and-categories.ts --output-dir=./scripts-output",
    "scripts:list-courses": "ts-node src/scripts/sort-courses-by-category-structure.ts --list-courses",
    "scripts:assign": "ts-node src/scripts/assign-courses-to-categories.ts",
    "scripts:sort-courses": "ts-node src/scripts/sort-courses-by-category-structure.ts",
    "scripts:sort-courses:apply": "ts-node src/scripts/sort-courses-by-category-structure.ts --apply",
    "scripts:update-category-order": "ts-node src/scripts/update-category-sort-order.ts",
    "scripts:update-brochures": "ts-node src/scripts/updateCourseBrochures.ts",
    "scripts:reset-enrollments-no-cert": "ts-node src/scripts/reset-enrollments-without-certificate.ts",
    "scripts:remove-certificates-all": "ts-node src/scripts/remove-certificates-all.ts",
    "scripts:import-colleges": "ts-node src/scripts/import-colleges-json.ts"
  },
  "keywords": [
    "airkrit",
    "backend",
    "api",
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx-pdf": "^0.0.1",
    "docxtemplater": "^3.67.5",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "paytm-pg-node-sdk": "^1.0.6",
    "paytmchecksum": "^1.5.1",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "serve-favicon": "^2.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "uuid": "^11.1.0",
    "xmldom": "^0.6.0",
    "zod": "^3.25.72"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.10.5",
    "@types/paytmchecksum": "^1.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/serve-favicon": "^2.5.7",
    "nodemon": "^3.0.2"
  }
}
