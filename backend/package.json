{
  "name": "airkrit-backend",
  "version": "1.0.0",
  "description": "Backend API for Airkrit platform",
  "main": "dist/server.js",
  "scripts": {
    "scripts:migrate-live-classes": "ts-node src/scripts/migrate-live-classes-to-datetime.ts",
    "scripts:migrate-live-classes:apply": "ts-node src/scripts/migrate-live-classes-to-datetime.ts --apply",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:cluster": "npm run build && pm2 start ecosystem.config.cjs",
    "start:worker": "node dist/worker.js",
    "start:worker:cert": "node dist/certificate-worker.js",
    "start:worker:collab": "node dist/collaboration-worker.js",
    "start:worker:token-cleanup": "node dist/token-cleanup-worker.js",
    "start:worker:offer-letter": "node dist/offer-letter-worker.js",
    "start:worker:invoice": "node dist/invoice-worker.js",
    "start:worker:internship-eval": "node dist/internship-evaluation-worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:watch": "nodemon --exec ts-node src/server.ts",
    "scripts:list": "ts-node src/scripts/list-courses-and-categories.ts",
    "scripts:list:out": "ts-node src/scripts/list-courses-and-categories.ts --output-dir=./scripts-output",
    "scripts:list-courses": "ts-node src/scripts/sort-courses-by-category-structure.ts --list-courses",
    "scripts:assign": "ts-node src/scripts/assign-courses-to-categories.ts",
    "scripts:sort-courses": "ts-node src/scripts/sort-courses-by-category-structure.ts",
    "scripts:sort-courses:apply": "ts-node src/scripts/sort-courses-by-category-structure.ts --apply",
    "scripts:update-category-order": "ts-node src/scripts/update-category-sort-order.ts",
    "scripts:update-brochures": "ts-node src/scripts/updateCourseBrochures.ts",
    "scripts:reset-enrollments-no-cert": "ts-node src/scripts/reset-enrollments-without-certificate.ts",
    "scripts:remove-certificates-all": "ts-node src/scripts/remove-certificates-all.ts",
    "scripts:import-colleges": "ts-node src/scripts/import-colleges-json.ts",
    "scripts:college-students": "ts-node src/scripts/college-student-counts.ts",
    "scripts:export-students-by-college": "ts-node src/scripts/export-students-with-college.ts",
    "scripts:export-user-profiles": "ts-node src/scripts/export-user-profiles.ts",
    "scripts:export-internship-applications": "ts-node src/scripts/export-internship-applications.ts",
    "scripts:remove-enrollments-window": "ts-node src/scripts/remove-enrollments-by-enrolledAt-window.ts",
    "scripts:seed-home-page": "ts-node src/scripts/seed-home-page-settings.ts",
    "scripts:seed-enquiry-page": "ts-node src/scripts/seed-enquiry-page-settings.ts",
    "scripts:seed-enquiry-page:apply": "ts-node src/scripts/seed-enquiry-page-settings.ts --apply",
    "scripts:wipe-questions": "ts-node src/scripts/wipe-internship-questions.ts",
    "scripts:wipe-questions:confirm": "ts-node src/scripts/wipe-internship-questions.ts --confirm",
    "scripts:migrate-task-due-days": "ts-node src/scripts/migrate-task-due-days.ts",
    "scripts:migrate-task-due-days:apply": "ts-node src/scripts/migrate-task-due-days.ts --apply",
    "scripts:backfill-referral-commission": "ts-node src/scripts/backfill-referral-commission.ts",
    "scripts:backfill-referral-commission:apply": "ts-node src/scripts/backfill-referral-commission.ts --apply",
    "scripts:migrate-documentation-to-batch": "ts-node src/scripts/migrate-documentation-to-batch.ts",
    "scripts:migrate-documentation-to-batch:apply": "ts-node src/scripts/migrate-documentation-to-batch.ts --apply",
    "scripts:drop-scholarship-otp-throttles": "ts-node src/scripts/drop-scholarship-otp-throttles.ts",
    "scripts:drop-scholarship-otp-throttles:apply": "ts-node src/scripts/drop-scholarship-otp-throttles.ts --apply",
    "scripts:cleanup-orphan-task-templates": "ts-node src/scripts/cleanup-orphan-task-templates.ts",
    "scripts:cleanup-orphan-task-templates:apply": "ts-node src/scripts/cleanup-orphan-task-templates.ts --apply",
    "scripts:seed-sample-certs": "ts-node src/scripts/seed-sample-certificates.ts",
    "scripts:remove-sample-certs": "ts-node src/scripts/remove-sample-certificates.ts",
    "scripts:diagnose-missing-duration": "ts-node src/scripts/diagnose-missing-program-duration.ts",
    "scripts:dry-run-cert-verdicts": "ts-node src/scripts/dry-run-internship-certificate-verdicts.ts",
    "scripts:dry-run-cert-verdicts:csv": "ts-node src/scripts/dry-run-internship-certificate-verdicts.ts --csv",
    "scripts:repair-duration": "ts-node src/scripts/repair-program-duration.ts",
    "scripts:repair-duration:apply": "ts-node src/scripts/repair-program-duration.ts --apply",
    "scripts:reset-premature-verdicts": "ts-node src/scripts/reset-premature-internship-verdicts.ts",
    "scripts:reset-premature-verdicts:apply": "ts-node src/scripts/reset-premature-internship-verdicts.ts --apply",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "airkrit",
    "backend",
    "api",
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx-pdf": "^0.0.1",
    "docxtemplater": "^3.67.5",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "node-cron": "^4.2.1",
    "paytm-pg-node-sdk": "^1.0.6",
    "paytmchecksum": "^1.5.1",
    "pizzip": "^3.2.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "serve-favicon": "^2.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "uuid": "^11.1.0",
    "xmldom": "^0.6.0",
    "zod": "^3.25.72"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.10.5",
    "@types/paytmchecksum": "^1.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/serve-favicon": "^2.5.7",
    "nodemon": "^3.0.2",
    "vitest": "^2.1.9"
  }
}
